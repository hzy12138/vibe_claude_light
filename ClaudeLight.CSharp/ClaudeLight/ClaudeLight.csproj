<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ClaudeLight.CLI\ClaudeLight.CLI.csproj" />
  </ItemGroup>


  <ItemGroup>
    <Resource Include="Resources\lightbulb.ico" />
    <Resource Include="Resources\rgb.svg" />
    <None Update="Resources\lightbulb.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\rgb.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- EXE 图标与托盘图标统一使用 lightbulb.ico（含 16/32/64/256 四档） -->
    <ApplicationIcon>Resources\lightbulb.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
